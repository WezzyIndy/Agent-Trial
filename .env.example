# LLM provider — pick one
ANTHROPIC_API_KEY=...
# OPENAI_API_KEY=...
# FIREWORKS_API_KEY=...

# Jobber API credentials
# Step 1: Go to https://developer.getjobber.com and create an app.
# Step 2: Complete the OAuth flow to get tokens (see src/react_agent/jobber_client.py for details).
JOBBER_CLIENT_ID=...
JOBBER_CLIENT_SECRET=...
JOBBER_ACCESS_TOKEN=...
JOBBER_REFRESH_TOKEN=...

# Optional — separates traces in LangSmith
LANGSMITH_PROJECT=pressure-washing-agent

# Required only if you re-enable the Tavily web search tool
# TAVILY_API_KEY=...
